{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "data_type": {
      "type": "string",
      "enum": [
        "live",
        "test"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "accounts": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "broker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "valuation_currency": {
            "type": "string",
            "enum": [
              "CNY",
              "SGD",
              "USD",
              "HKD",
              "EUR",
              "GBP"
            ]
          },
          "net_liquidation_value": {
            "type": "string",
            "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
          },
          "cash_balances": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "enum": [
                    "CNY",
                    "SGD",
                    "USD",
                    "HKD",
                    "EUR",
                    "GBP"
                  ]
                },
                "amount": {
                  "type": "string",
                  "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
                }
              },
              "required": [
                "currency",
                "amount"
              ],
              "additionalProperties": false
            }
          },
          "positions_complete": {
            "default": true,
            "type": "boolean"
          },
          "positions": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "security_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "instrument_type": {
                  "type": "string",
                  "enum": [
                    "stock",
                    "etf",
                    "fund",
                    "bond",
                    "option",
                    "other"
                  ]
                },
                "currency": {
                  "type": "string",
                  "enum": [
                    "CNY",
                    "SGD",
                    "USD",
                    "HKD",
                    "EUR",
                    "GBP"
                  ]
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
                },
                "market_value": {
                  "type": "string",
                  "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
                },
                "cost_value": {
                  "type": "string",
                  "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
                },
                "reported_unrealized_pnl": {
                  "type": "string",
                  "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
                },
                "price_as_of": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "security_id",
                "symbol",
                "instrument_type",
                "currency"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "account_id",
          "broker",
          "name",
          "valuation_currency",
          "cash_balances",
          "positions_complete",
          "positions"
        ],
        "additionalProperties": false
      }
    },
    "fx_rates": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "CNY",
              "SGD",
              "USD",
              "HKD",
              "EUR",
              "GBP"
            ]
          },
          "rate_to_cny": {
            "type": "string",
            "pattern": "^-?\\d{1,18}(\\.\\d{1,12})?$"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "required": [
          "currency",
          "rate_to_cny",
          "as_of",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source",
    "snapshot_id",
    "revision",
    "data_type",
    "as_of",
    "generated_at",
    "complete",
    "accounts",
    "fx_rates"
  ],
  "additionalProperties": false
}
